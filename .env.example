# =====================================================================
#  Cilegon Enggih — Environment Variables
#  Copy file ini menjadi `.env` (lokal) atau isi di dashboard hosting.
#  JANGAN commit file .env yang berisi kredensial asli.
# =====================================================================

# --- Server lokal / self-host -----------------------------------------
PORT=3001
BIND_HOST=0.0.0.0

# --- Super Admin Dashboard --------------------------------------------
# Password login /admin. WAJIB diganti sebelum go-live.
ADMIN_PASSWORD=enggih2026
# Secret untuk menandatangani token admin (string acak panjang).
ADMIN_TOKEN_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# --- Storage (opsional tapi disarankan untuk produksi) ----------------
# Kalau dua variabel ini diisi, backend otomatis memakai Supabase (Postgres)
# dan tidak lagi menulis ke filesystem (penting untuk Vercel/Cloudflare).
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Alternatif kalau tidak memakai service role (butuh policy RLS terbuka):
# SUPABASE_ANON_KEY=

# Format kunci Supabase yang didukung:
#   • Legacy JWT  : eyJhbGciOi...            (service_role)
#   • Baru (2025) : sb_secret_xxxxxxxxxxxx   (Secret key — JANGAN dipakai di browser)
# Alias env yang juga dibaca: SUPABASE_SECRET_KEY / SUPABASE_SERVICE_KEY / SUPABASE_ANON_KEY.
# Tabel dokumen (default: ce_documents). Lihat supabase-schema.sql.
SUPABASE_DOCS_TABLE=ce_documents

# --- Storage fallback lokal -------------------------------------------
# Folder JSON bila Supabase belum diset. Di serverless otomatis jatuh ke /tmp.
CE_DATA_DIR=./server/data

# --- Cloudflare Pages (hanya untuk functions/api/[[route]].js) ---------
# URL backend API (deployment Vercel / VPS) yang diproxy oleh Cloudflare.
API_ORIGIN=

# --- Frontend (Vite) ---------------------------------------------------
# Kosongkan untuk same-origin (default). Isi kalau SPA & API beda domain.
# VITE_API_BASE_URL=https://api.cilegonenggih.vercel.app
