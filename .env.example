# ── Info Kelurahan — contoh konfigurasi ─────────────────────────────
# Salin menjadi .env untuk pemakaian lokal. Di Vercel, isi lewat
# Project Settings → Environment Variables.

# Password dashboard /admin. WAJIB diganti sebelum go-live.
ADMIN_PASSWORD=ganti-password-ini

# Kunci HMAC sesi admin (opsional). Bila kosong, dibuat otomatis
# dan disimpan di database.
# ADMIN_SECRET=string-acak-panjang

# Masa berlaku token login (jam). Default 12.
# ADMIN_TOKEN_TTL_HOURS=12

# URL publik untuk canonical XML sitemap/RSS saat build.
SITE_URL=https://infokelurahan.vercel.app

# Port API/Express. Vite dev mem-proxy /api ke port ini.
PORT=3001

# ── Supabase (opsional, sangat disarankan untuk produksi di Vercel) ──
# Vercel tidak menyimpan file permanen; tanpa Supabase data akan
# kembali ke seed setiap instance baru dibuat.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
# SUPABASE_TABLE=site_state
