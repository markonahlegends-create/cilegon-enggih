{
  "name": "cilegon-enggih-store",
  "private": true,
  "version": "1.0.0",
  "description": "E-Commerce Resmi Cilegon Enggih - Merchandise & Oleh-Oleh Modern Kebanggaan Kota Cilegon",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "node scripts/audit-bundles.mjs && node scripts/validate-vercel-config.mjs && node scripts/generate-og-data.mjs && node scripts/generate-og-pages.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "server": "node server/index.js",
    "start": "npm run build && node server/index.js",
    "dev:all": "concurrently -k \"node server/index.js\" \"vite --host 0.0.0.0 --port 5173\"",
    "preflight": "node scripts/preflight.mjs",
    "preflight:live": "node scripts/preflight.mjs",
    "og:images": "node scripts/generate-og-images.mjs",
    "og:data": "node scripts/generate-og-data.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "seed:catalog": "node scripts/generate-seed.mjs",
    "validate:vercel": "node scripts/validate-vercel-config.mjs",
    "audit:bundles": "node scripts/audit-bundles.mjs",
    "test:reports": "node scripts/test-report-consistency.mjs",
    "test:stock": "node scripts/test-stock.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:notify": "node scripts/test-notify.mjs",
    "test:notify:e2e": "node scripts/test-notify-e2e.mjs",
    "test:button": "node scripts/test-telegram-button.mjs",
    "test:share": "node scripts/test-share-dynamic.mjs",
    "test:editor": "node scripts/test-product-editor.mjs",
    "test:og": "node scripts/test-og-share.mjs",
    "test:crawler": "node scripts/test-crawler-ua.mjs",
    "test:vercel": "node scripts/test-vercel-validator.mjs",
    "test:all": "npm run test:payments && npm run test:stock && npm run test:reports && npm run test:notify && npm run test:og && npm run test:crawler && npm run test:vercel && npm run test:editor && npm run test:share && npm run test:button && npm run test:notify:e2e"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
